@@ -375,6 +375,24 @@ bool ZBundle::SignNode(jvalue& jvNode)
 		}
 	}
 
+	if (m_pSignAssets && !m_pSignAssets->empty() && "/" != strFolder) {
+		// Nested bundles (app extensions) need their own embedded.mobileprovision, written before
+		// CodeResources is generated so it is sealed. Use the matching profile, otherwise the main one.
+		ZSignAsset* pAsset = &m_pSignAssets->front();
+		for (auto it = m_pSignAssets->begin(); it != m_pSignAssets->end(); ++it) {
+			const string& appId = it->m_strApplicationId;
+			if (appId.size() >= strBundleId.size() && 0 == appId.compare(appId.size() - strBundleId.size(), strBundleId.size(), strBundleId)) {
+				pAsset = &(*it);
+				break;
+			}
+		}
+		m_pSignAsset = pAsset;
+		if (!m_pSignAsset->m_strProvData.empty() && !ZFile::WriteFileV(m_pSignAsset->m_strProvData, "%s/embedded.mobileprovision", strBaseFolder.c_str())) {
+			ZLog::ErrorV(">>> Can't write embedded.mobileprovision! %s\n", strFolder.c_str());
+			return false;
+		}
+	}
+
 	ZFile::CreateFolderV("%s/_CodeSignature", strBaseFolder.c_str());
 	string strCodeResFile = strBaseFolder + "/_CodeSignature/CodeResources";
 
