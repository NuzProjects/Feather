    "Feather notifies you 3 days and 1 day before the certificate in use expires, and checks for revocation in the background." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather notifies you 3 days and 1 day before the certificate in use expires, and checks for revocation in the background."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُنبّهك Feather قبل 3 أيام ويوم واحد من انتهاء الشهادة المستخدمة، ويتحقق من الإلغاء في الخلفية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather vás upozorní 3 dny a 1 den před vypršením používaného certifikátu a na pozadí kontroluje jeho zneplatnění."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather benachrichtigt dich 3 Tage und 1 Tag vor Ablauf des verwendeten Zertifikats und prüft im Hintergrund auf Widerruf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather te avisa 3 días y 1 día antes de que caduque el certificado en uso, y comprueba su revocación en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather vous prévient 3 jours et 1 jour avant l’expiration du certificat utilisé, et vérifie sa révocation en arrière-plan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather memberi tahu 3 hari dan 1 hari sebelum sertifikat yang digunakan kedaluwarsa, dan memeriksa pencabutan di latar belakang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather ti avvisa 3 giorni e 1 giorno prima della scadenza del certificato in uso e controlla la revoca in background."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather는 사용 중인 인증서가 만료되기 3일 전과 1일 전에 알려 주고, 백그라운드에서 해지 여부를 확인합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather powiadomi Cię 3 dni i 1 dzień przed wygaśnięciem używanego certyfikatu i sprawdza jego unieważnienie w tle."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather предупредит за 3 дня и за 1 день до истечения используемого сертификата и проверяет отзыв в фоне."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather, kullanılan sertifikanın süresi dolmadan 3 gün ve 1 gün önce seni uyarır ve arka planda iptal durumunu kontrol eder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather thông báo trước 3 ngày và 1 ngày khi chứng chỉ đang dùng hết hạn, và kiểm tra thu hồi trong nền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather 会在当前证书到期前 3 天和 1 天提醒你，并在后台检查是否被吊销。"
          }
        }
      }
    },
    "Feather signs apps with your own certificate. Get one from Apple or a provider below, then import it here." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather signs apps with your own certificate. Get one from Apple or a provider below, then import it here."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوقّع Feather التطبيقات بشهادتك الخاصة. احصل على واحدة من Apple أو من أحد المزودين أدناه، ثم استوردها هنا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather podepisuje aplikace vaším vlastním certifikátem. Získejte ho od Applu nebo od poskytovatele níže a pak ho sem importujte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather signiert Apps mit deinem eigenen Zertifikat. Hol dir eines von Apple oder einem Anbieter unten und importiere es hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather firma las apps con tu propio certificado. Consigue uno de Apple o de un proveedor de abajo y luego impórtalo aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather signe les apps avec votre propre certificat. Obtenez-en un auprès d’Apple ou d’un fournisseur ci-dessous, puis importez-le ici."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather menandatangani aplikasi dengan sertifikatmu sendiri. Dapatkan dari Apple atau penyedia di bawah, lalu impor di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather firma le app con il tuo certificato. Ottienine uno da Apple o da un fornitore qui sotto, poi importalo qui."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather는 내 인증서로 앱에 서명합니다. Apple이나 아래 제공업체에서 받은 뒤 여기서 가져오세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather podpisuje aplikacje Twoim certyfikatem. Zdobądź go od Apple lub dostawcy poniżej, a potem zaimportuj tutaj."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather подписывает приложения вашим сертификатом. Получите его у Apple или у поставщика ниже, затем импортируйте здесь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather uygulamaları kendi sertifikanla imzalar. Apple'dan veya aşağıdaki bir sağlayıcıdan edin, sonra buraya içe aktar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather ký ứng dụng bằng chứng chỉ của bạn. Hãy lấy từ Apple hoặc nhà cung cấp bên dưới, rồi nhập vào đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather 使用你自己的证书为应用签名。请从 Apple 或下方提供商获取，然后在此导入。"
          }
        }
      }
    },
    "Feather will close to finish. Open it again from the Home Screen." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather will close to finish. Open it again from the Home Screen."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُغلَق Feather لإكمال العملية. افتحه مرة أخرى من الشاشة الرئيسية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather se pro dokončení zavře. Znovu ho otevřete z plochy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather wird zum Abschließen geschlossen. Öffne es danach wieder vom Home-Bildschirm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather se cerrará para terminar. Vuelve a abrirlo desde la pantalla de inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather va se fermer pour terminer. Rouvrez-le depuis l’écran d’accueil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather akan ditutup untuk menyelesaikan. Buka lagi dari Layar Utama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather si chiuderà per completare. Riaprilo dalla schermata Home."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완료하려면 Feather가 종료됩니다. 홈 화면에서 다시 여세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather zamknie się, aby dokończyć. Otwórz go ponownie z ekranu początkowego."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather закроется, чтобы завершить. Откройте его снова с экрана «Домой»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitirmek için Feather kapanacak. Ana Ekran'dan tekrar aç."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather sẽ đóng để hoàn tất. Hãy mở lại từ Màn hình chính."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather 将关闭以完成操作。请从主屏幕重新打开。"
          }
        }
      }
    },
