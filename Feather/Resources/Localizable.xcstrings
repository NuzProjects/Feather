    "After gaining beta access, you're able to use exclusive features that may not be present on releases!" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After gaining beta access, you're able to use exclusive features that may not be present on releases!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po uzyskaniu dostępu do wersji beta możesz korzystać z ekskluzywnych funkcji, których może nie być w wydaniach!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "베타 액세스를 얻으면 정식 릴리스에 없을 수 있는 독점 기능을 사용할 수 있습니다!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta erişimi kazandıktan sonra sürümlerde bulunmayabilecek özel özellikleri kullanabilirsiniz!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "获得测试版访问权限后，你可以使用正式版中可能没有的专属功能！"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد الحصول على وصول بيتا، يمكنك استخدام ميزات حصرية قد لا تتوفر في الإصدارات!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi có quyền truy cập beta, bạn có thể dùng các tính năng độc quyền có thể chưa có trong bản phát hành!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con l’accesso beta puoi usare funzioni esclusive che potrebbero non essere presenti nelle release!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Beta-Zugang kannst du exklusive Funktionen nutzen, die es in den Releases eventuell nicht gibt!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah mendapat akses beta, kamu bisa memakai fitur eksklusif yang mungkin belum ada di rilis!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S přístupem k betě můžete používat exkluzivní funkce, které ve vydáních nemusí být!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec l’accès bêta, vous pouvez utiliser des fonctionnalités exclusives absentes des versions publiques !"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
