            "value" : "Apple ile iletişim sırasında bir güvenlik adımı başarısız oldu (%@). Tekrar deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与 Apple 通信时某个安全步骤失败（%@）。请重试。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشلت خطوة أمان أثناء التواصل مع Apple (%@). حاول مرة أخرى."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một bước bảo mật thất bại khi kết nối với Apple (%@). Hãy thử lại."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un passaggio di sicurezza non è riuscito durante la comunicazione con Apple (%@). Riprova."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Sicherheitsschritt ist bei der Verbindung mit Apple fehlgeschlagen (%@). Versuche es erneut."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu langkah keamanan gagal saat berkomunikasi dengan Apple (%@). Coba lagi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při komunikaci s Applem selhal bezpečnostní krok (%@). Zkuste to znovu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une étape de sécurité a échoué lors de la communication avec Apple (%@). Réessayez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сбой шага безопасности при связи с Apple (%@). Попробуйте ещё раз."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falló un paso de seguridad al comunicarse con Apple (%@). Inténtalo de nuevo."
          }
        }
      }
    },
