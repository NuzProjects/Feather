    "This Apple ID isn't set up for app signing yet. Sign in once at developer.apple.com, accept the agreement, then try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Apple ID isn't set up for app signing yet. Sign in once at developer.apple.com, accept the agreement, then try again."
          }
        },
        "pl" : {
          "stringUnit" : {
