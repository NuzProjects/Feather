    "GitHub is limiting how often Feather can check right now. Try again in a few minutes." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub is limiting how often Feather can check right now. Try again in a few minutes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub ogranicza teraz, jak często Feather może sprawdzać. Spróbuj ponownie za kilka minut."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub가 현재 Feather의 확인 횟수를 제한하고 있습니다. 몇 분 후 다시 시도하세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub şu anda Feather'ın ne sıklıkla kontrol edebileceğini sınırlıyor. Birkaç dakika sonra tekrar deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub 目前限制了 Feather 的检查频率。请几分钟后再试。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحدّ GitHub حاليًا من عدد مرات تحقق Feather. حاول مجددًا بعد بضع دقائق."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub đang giới hạn tần suất Feather kiểm tra. Hãy thử lại sau vài phút."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub sta limitando la frequenza dei controlli di Feather. Riprova tra qualche minuto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub begrenzt gerade, wie oft Feather prüfen darf. Versuche es in ein paar Minuten erneut."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub sedang membatasi seberapa sering Feather dapat memeriksa. Coba lagi dalam beberapa menit."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub teď omezuje, jak často může Feather kontrolovat. Zkuste to za pár minut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub limite actuellement la fréquence des vérifications de Feather. Réessayez dans quelques minutes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub сейчас ограничивает частоту проверок Feather. Повторите попытку через несколько минут."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub está limitando la frecuencia con la que Feather puede comprobar. Inténtalo de nuevo en unos minutos."
          }
        }
      }
    },
