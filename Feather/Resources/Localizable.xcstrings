    "Includes crashes caught by Feather and diagnostic reports from iOS, which can arrive up to a day later." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Includes crashes caught by Feather and diagnostic reports from iOS, which can arrive up to a day later."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشمل الأعطال التي التقطها Feather وتقارير التشخيص من iOS، والتي قد تصل بعد يوم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahrnuje pády zachycené Featherem a diagnostické zprávy z iOS, které mohou dorazit až o den později."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enthält von Feather erfasste Abstürze und Diagnoseberichte von iOS, die bis zu einen Tag später eintreffen können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluye los fallos detectados por Feather y los informes de diagnóstico de iOS, que pueden llegar hasta un día después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprend les plantages détectés par Feather et les rapports de diagnostic d’iOS, qui peuvent arriver jusqu’à un jour plus tard."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termasuk crash yang ditangkap Feather dan laporan diagnostik dari iOS, yang bisa datang hingga sehari kemudian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Include gli arresti anomali rilevati da Feather e i report diagnostici di iOS, che possono arrivare fino a un giorno dopo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather가 감지한 충돌과 iOS 진단 보고서가 포함되며, 진단 보고서는 최대 하루 뒤에 도착할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obejmuje awarie wychwycone przez Feather i raporty diagnostyczne z iOS, które mogą dotrzeć nawet dzień później."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включает сбои, пойманные Feather, и диагностические отчёты iOS, которые могут прийти до суток спустя."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feather'ın yakaladığı çökmeleri ve bir gün sonra gelebilen iOS tanılama raporlarını içerir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bao gồm sự cố do Feather ghi lại và báo cáo chẩn đoán từ iOS, có thể đến muộn tới một ngày."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包括 Feather 捕获的崩溃以及 iOS 的诊断报告，后者可能延迟最多一天送达。"
          }
        }
      }
    },
