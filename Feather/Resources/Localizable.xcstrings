    "Keep this GitHub repository in Sources to browse its IPA releases later." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep this GitHub repository in Sources to browse its IPA releases later."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowaj to repozytorium GitHub w źródłach, aby później przeglądać jego wydania IPA."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나중에 IPA 릴리스를 둘러볼 수 있도록 이 GitHub 저장소를 소스에 보관합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA sürümlerine daha sonra göz atmak için bu GitHub deposunu Kaynaklar'da tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将此 GitHub 仓库保留在“源”中，以便稍后浏览其 IPA 版本。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتفظ بمستودع GitHub هذا في المصادر لتصفح إصدارات IPA لاحقًا."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ kho GitHub này trong Nguồn để xem các bản phát hành IPA sau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni questo repository GitHub nelle fonti per sfogliarne le release IPA più tardi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte dieses GitHub-Repository in den Quellen, um später seine IPA-Releases zu durchsuchen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan repositori GitHub ini di Sumber untuk melihat rilis IPA-nya nanti."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponechte tento repozitář GitHubu ve zdrojích a procházejte jeho vydání IPA později."
          }
        },
