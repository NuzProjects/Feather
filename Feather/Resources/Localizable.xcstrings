    "Each app gets its own provisioning profile from Apple when you sign it. Re-sign apps before 7 days pass to keep them opening." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each app gets its own provisioning profile from Apple when you sign it. Re-sign apps before 7 days pass to keep them opening."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda aplikacja dostaje od Apple własny profil podczas podpisywania. Podpisz aplikacje ponownie przed upływem 7 dni, aby nadal się otwierały."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 앱은 서명할 때 Apple에서 자체 프로비저닝 프로파일을 받습니다. 앱이 계속 열리도록 7일이 지나기 전에 다시 서명하세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her uygulama imzalandığında Apple'dan kendi hazırlık profilini alır. Açılmaya devam etmeleri için uygulamaları 7 gün dolmadan yeniden imzalayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个应用在签名时都会从 Apple 获得自己的描述文件。请在 7 天内重新签名，应用才能继续打开。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحصل كل تطبيق على ملف تعريف خاص به من Apple عند توقيعه. أعد توقيع التطبيقات قبل مرور 7 أيام لتستمر في الفتح."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi ứng dụng nhận hồ sơ cấp phép riêng từ Apple khi bạn ký. Hãy ký lại trước khi hết 7 ngày để ứng dụng tiếp tục mở được."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni app riceve da Apple un proprio profilo di provisioning quando la firmi. Firma di nuovo le app prima che passino 7 giorni per continuare ad aprirle."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede App erhält beim Signieren ein eigenes Bereitstellungsprofil von Apple. Signiere Apps vor Ablauf von 7 Tagen neu, damit sie sich weiter öffnen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap app mendapat profil provisioning sendiri dari Apple saat ditandatangani. Tandatangani ulang sebelum 7 hari berlalu agar app tetap bisa dibuka."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každá aplikace dostane při podepsání od Applu vlastní zřizovací profil. Podepište aplikace znovu dřív, než uplyne 7 dní, aby se dál otevíraly."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque app reçoit son propre profil d’approvisionnement d’Apple lors de la signature. Resignez les apps avant 7 jours pour qu’elles continuent de s’ouvrir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждое приложение получает от Apple собственный профиль при подписи. Переподпишите приложения до истечения 7 дней, чтобы они продолжали открываться."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada app recibe su propio perfil de aprovisionamiento de Apple al firmarla. Vuelve a firmar las apps antes de que pasen 7 días para que sigan abriéndose."
          }
        }
      }
    }
  },
  "version" : "1.0"
}