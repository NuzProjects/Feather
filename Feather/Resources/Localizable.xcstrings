    "Developer Logs has crash reports and errors you can export for bug reports." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Developer Logs has crash reports and errors you can export for bug reports."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتوي سجلات المطور على تقارير الأعطال والأخطاء التي يمكنك تصديرها للإبلاغ عن المشكلات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vývojářské protokoly obsahují zprávy o pádech a chyby, které můžete exportovat do hlášení chyb."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Entwicklerprotokolle enthalten Absturzberichte und Fehler, die du für Fehlerberichte exportieren kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los registros de desarrollador contienen informes de fallos y errores que puedes exportar para informar de problemas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les journaux développeur contiennent les rapports de plantage et les erreurs à exporter pour signaler un bug."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log Pengembang berisi laporan crash dan galat yang bisa kamu ekspor untuk laporan bug."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I log sviluppatore contengono report di arresti anomali ed errori da esportare per segnalare bug."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개발자 로그에는 버그 신고용으로 내보낼 수 있는 충돌 보고서와 오류가 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzienniki dewelopera zawierają raporty awarii i błędy, które możesz wyeksportować do zgłoszenia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В журналах разработчика есть отчёты о сбоях и ошибки, которые можно экспортировать для сообщения об ошибке."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geliştirici Kayıtları, hata bildirimi için dışa aktarabileceğin çökme raporlarını ve hataları içerir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhật ký nhà phát triển có báo cáo sự cố và lỗi mà bạn có thể xuất để báo lỗi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开发者日志包含崩溃报告和错误，可导出用于报告问题。"
          }
        }
      }
    },
