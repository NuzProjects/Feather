    "Apple revoked %@. Apps signed with it won't open anymore, so add a new certificate." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple revoked %@. Apps signed with it won't open anymore, so add a new certificate."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ألغت Apple الشهادة %@. لن تفتح التطبيقات الموقّعة بها بعد الآن، لذا أضف شهادة جديدة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple zneplatnil %@. Aplikace jím podepsané se už neotevřou, přidejte proto nový certifikát."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple hat %@ widerrufen. Damit signierte Apps öffnen sich nicht mehr, füge also ein neues Zertifikat hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple revocó %@. Las apps firmadas con él ya no se abrirán, así que añade un certificado nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple a révoqué %@. Les apps signées avec ne s’ouvriront plus, ajoutez donc un nouveau certificat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple mencabut %@. Aplikasi yang ditandatangani dengannya tidak akan terbuka lagi, jadi tambahkan sertifikat baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ha revocato %@. Le app firmate con esso non si apriranno più, quindi aggiungi un nuovo certificato."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple이 %@ 인증서를 해지했습니다. 이 인증서로 서명한 앱은 더 이상 열리지 않으니 새 인증서를 추가하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple unieważnił %@. Aplikacje nim podpisane nie będą się już otwierać, więc dodaj nowy certyfikat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple отозвала %@. Подписанные им приложения больше не откроются, поэтому добавьте новый сертификат."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple %@ sertifikasını iptal etti. Onunla imzalanan uygulamalar artık açılmayacak, bu yüzden yeni bir sertifika ekle."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple đã thu hồi %@. Ứng dụng ký bằng chứng chỉ này sẽ không mở được nữa, hãy thêm chứng chỉ mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 已吊销 %@。使用它签名的应用将无法再打开，请添加新证书。"
          }
        }
      }
    },
