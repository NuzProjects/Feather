    "Your network or DNS is blocking the address Fully Local uses, so iOS can't reach Feather's install server." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your network or DNS is blocking the address Fully Local uses, so iOS can't reach Feather's install server."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شبكتك أو خادم DNS يحظر العنوان الذي يستخدمه Fully Local، لذلك لا يستطيع iOS الوصول إلى خادم التثبيت في Feather."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše síť nebo DNS blokuje adresu, kterou Fully Local používá, takže iOS se nedostane k instalačnímu serveru Featheru."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Netzwerk oder DNS blockiert die Adresse, die Fully Local verwendet, daher erreicht iOS den Installationsserver von Feather nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu red o DNS está bloqueando la dirección que usa Fully Local, así que iOS no puede llegar al servidor de instalación de Feather."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre réseau ou DNS bloque l’adresse utilisée par Fully Local, donc iOS ne peut pas joindre le serveur d’installation de Feather."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaringan atau DNS Anda memblokir alamat yang digunakan Fully Local, jadi iOS tidak dapat menjangkau server instalasi Feather."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua rete o il DNS blocca l’indirizzo usato da Fully Local, quindi iOS non riesce a raggiungere il server di installazione di Feather."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네트워크 또는 DNS가 Fully Local이 사용하는 주소를 차단하고 있어 iOS가 Feather의 설치 서버에 연결할 수 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja sieć lub DNS blokuje adres używany przez Fully Local, więc iOS nie może połączyć się z serwerem instalacji Feather."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша сеть или DNS блокирует адрес, который использует Fully Local, поэтому iOS не может связаться с сервером установки Feather."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağın veya DNS’in Fully Local’ın kullandığı adresi engelliyor, bu yüzden iOS Feather’ın yükleme sunucusuna ulaşamıyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mạng hoặc DNS của bạn đang chặn địa chỉ mà Fully Local dùng, nên iOS không thể kết nối tới máy chủ cài đặt của Feather."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的网络或 DNS 阻止了 Fully Local 使用的地址，因此 iOS 无法连接 Feather 的安装服务器。"
          }
        }
      }
    },
    "iOS didn't start the install from Feather's local server." : {
