    "Each launch gets its own log with signing, install, download and update errors, plus Feather's system log." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each launch gets its own log with signing, install, download and update errors, plus Feather's system log."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لكل تشغيل سجل خاص به يتضمن أخطاء التوقيع والتثبيت والتنزيل والتحديث، بالإضافة إلى سجل نظام Feather."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každé spuštění má vlastní protokol s chybami podepisování, instalace, stahování a aktualizací a také systémový protokol Featheru."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Start hat ein eigenes Protokoll mit Signatur-, Installations-, Download- und Update-Fehlern sowie dem Systemprotokoll von Feather."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada inicio tiene su propio registro con errores de firma, instalación, descarga y actualización, además del registro del sistema de Feather."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque lancement a son propre journal avec les erreurs de signature, d’installation, de téléchargement et de mise à jour, ainsi que le journal système de Feather."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap kali dibuka punya log sendiri berisi galat tanda tangan, instalasi, unduhan, dan pembaruan, plus log sistem Feather."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni avvio ha il proprio log con gli errori di firma, installazione, download e aggiornamento, più il log di sistema di Feather."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행할 때마다 서명, 설치, 다운로드, 업데이트 오류와 Feather 시스템 로그가 담긴 별도 로그가 생성됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde uruchomienie ma własny dziennik z błędami podpisywania, instalacji, pobierania i aktualizacji oraz dziennikiem systemowym Feather."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У каждого запуска свой журнал с ошибками подписи, установки, загрузки и обновления, а также системный журнал Feather."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her açılışın imzalama, kurulum, indirme ve güncelleme hatalarını ve Feather'ın sistem kaydını içeren kendi kaydı vardır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi lần mở có nhật ký riêng gồm lỗi ký, cài đặt, tải xuống và cập nhật, cùng nhật ký hệ thống của Feather."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次启动都有独立的日志，包含签名、安装、下载和更新错误，以及 Feather 的系统日志。"
          }
        }
      }
    },
