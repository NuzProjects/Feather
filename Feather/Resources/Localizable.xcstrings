    "A link wants to add the certificate \"%@\" to Feather. Only add certificates you trust." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A link wants to add the certificate \"%@\" to Feather. Only add certificates you trust."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يريد رابط إضافة الشهادة \"%@\" إلى Feather. أضف فقط الشهادات التي تثق بها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odkaz chce do Featheru přidat certifikát „%@“. Přidávejte jen certifikáty, kterým důvěřujete."
