    "Removing the provisioning file will exclude the mobileprovision file from being embedded inside of the application when signing, to help prevent any detection." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إزالة ملف Provisioning ستمنع تضمين ملف mobileprovision داخل التطبيق أثناء التوقيع، مما يساعد على تقليل احتمالية اكتشافه."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removing the provisioning file will exclude the mobileprovision file from being embedded inside of the application when signing, to help prevent any detection."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovere il file di provisioning escluderà il file .mobileprovision dall’essere incorporato nell’app durante la firma, aiutando così a evitare qualsiasi rilevamento."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로비저닝 파일을 제거하면 서명 시 ‘mobileprovision’ 파일이 애플리케이션 내에 포함되지 않게 되어, 탐지를 방지하는 데 도움이 됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięcie pliku provisioning spowoduje, że plik mobileprovision nie będzie osadzony w aplikacji podczas podpisywania, co zapobiegnie jakiemukolwiek wykryciu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazırlık profilinin kaldırılması imzalama sırasında “mobileprovision” dosyasının uygulamaya dahil edilmemesini sağlayarak herhangi bir tespitin önlenmesine yardımcı olur. "
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa tệp mobileprovision được nhúng bên trong ứng dụng khi ký, giúp ngăn chặn mọi phát hiện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除描述文件后，签名时就不会将其嵌入到App中，从而防止被检测到。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Provisioning-Datei wird die mobileprovision-Datei beim Signieren nicht in die App eingebettet, was eine Erkennung erschwert."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus file provisioning membuat file mobileprovision tidak disematkan ke aplikasi saat ditandatangani, untuk membantu mencegah deteksi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odebráním souboru provisioning se soubor mobileprovision při podepisování do aplikace nevloží, což pomáhá zabránit odhalení."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer le profil d’approvisionnement évite d’intégrer le fichier mobileprovision dans l’app lors de la signature, pour limiter la détection."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаление профиля обеспечения исключает встраивание файла mobileprovision в приложение при подписи, чтобы избежать обнаружения."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitar el perfil de aprovisionamiento evita que el archivo mobileprovision se incruste en la app al firmar, para ayudar a evitar la detección."
          }
        }
      }
    },
