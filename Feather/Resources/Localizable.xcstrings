    "No sources were found on the clipboard. Copy the sources exported from KravaSign, MapleSign or ESign, then tap Import again." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No sources were found on the clipboard. Copy the sources exported from KravaSign, MapleSign or ESign, then tap Import again."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُعثر على مصادر في الحافظة. انسخ المصادر المُصدَّرة من KravaSign أو MapleSign أو ESign، ثم اضغط استيراد مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve schránce nebyly nalezeny žádné zdroje. Zkopírujte zdroje exportované z KravaSign, MapleSign nebo ESign a znovu klepněte na Importovat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Zwischenablage wurden keine Quellen gefunden. Kopiere die aus KravaSign, MapleSign oder ESign exportierten Quellen und tippe erneut auf Importieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontraron fuentes en el portapapeles. Copia las fuentes exportadas desde KravaSign, MapleSign o ESign y vuelve a tocar Importar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune source trouvée dans le presse-papiers. Copiez les sources exportées depuis KravaSign, MapleSign ou ESign, puis touchez à nouveau Importer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada sumber di papan klip. Salin sumber yang diekspor dari KravaSign, MapleSign, atau ESign, lalu ketuk Impor lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna sorgente trovata negli appunti. Copia le sorgenti esportate da KravaSign, MapleSign o ESign, poi tocca di nuovo Importa."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클립보드에서 소스를 찾지 못했습니다. KravaSign, MapleSign 또는 ESign에서 내보낸 소스를 복사한 뒤 다시 가져오기를 누르세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W schowku nie znaleziono źródeł. Skopiuj źródła wyeksportowane z KravaSign, MapleSign lub ESign i ponownie stuknij Importuj."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В буфере обмена нет источников. Скопируйте источники, экспортированные из KravaSign, MapleSign или ESign, и снова нажмите «Импорт»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panoda kaynak bulunamadı. KravaSign, MapleSign veya ESign'dan dışa aktarılan kaynakları kopyala, sonra tekrar İçe Aktar'a dokun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không tìm thấy nguồn trong bảng nhớ tạm. Hãy sao chép nguồn đã xuất từ KravaSign, MapleSign hoặc ESign rồi chạm Nhập lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "剪贴板中未找到源。请复制从 KravaSign、MapleSign 或 ESign 导出的源，然后再次轻点“导入”。"
          }
        }
      }
    },
