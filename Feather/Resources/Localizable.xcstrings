    "Choose which tabs appear in the navigation bar and drag to reorder them. Settings is always available." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose which tabs appear in the navigation bar and drag to reorder them. Settings is always available."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz, które karty pojawiają się na pasku nawigacji, i przeciągnij, aby zmienić ich kolejność. Ustawienia są zawsze dostępne."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탐색 막대에 표시할 탭을 선택하고 드래그해 순서를 바꾸세요. 설정은 항상 표시됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gezinme çubuğunda hangi sekmelerin görüneceğini seçin ve sıralamak için sürükleyin. Ayarlar her zaman kullanılabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择要在导航栏中显示的标签页，并拖动以重新排序。“设置”始终可用。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر علامات التبويب التي تظهر في شريط التنقل واسحبها لإعادة ترتيبها. الإعدادات متاحة دائمًا."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn tab hiển thị trên thanh điều hướng và kéo để sắp xếp. Cài đặt luôn có sẵn."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli quali schede mostrare nella barra di navigazione e trascinale per riordinarle. Impostazioni è sempre disponibile."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, welche Tabs in der Navigationsleiste erscheinen, und ziehe sie zum Sortieren. Einstellungen ist immer verfügbar."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih tab yang muncul di bilah navigasi dan seret untuk mengurutkan. Pengaturan selalu tersedia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte, které karty se zobrazí v navigační liště, a přetažením změňte pořadí. Nastavení je vždy k dispozici."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les onglets affichés dans la barre de navigation et faites-les glisser pour les réorganiser. Réglages est toujours disponible."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите вкладки для панели навигации и перетащите их, чтобы изменить порядок. Настройки всегда доступны."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige qué pestañas aparecen en la barra de navegación y arrástralas para reordenarlas. Ajustes siempre está disponible."
          }
        }
      }
    },
