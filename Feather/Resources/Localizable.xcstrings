    "Unable to connect to TCP. Make sure you have loopback VPN enabled and you are on WiFi or Airplane mode." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unable to connect to TCP. Make sure you have loopback VPN enabled and you are on WiFi or Airplane mode."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można połączyć się przez TCP. Upewnij się, że VPN loopback jest włączony i masz Wi-Fi lub tryb samolotowy."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TCP에 연결할 수 없습니다. 루프백 VPN이 켜져 있고 Wi-Fi 또는 에어플레인 모드인지 확인하세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TCP'ye bağlanılamıyor. Geri döngü VPN'inin açık olduğundan ve Wi-Fi'da veya Uçak Modunda olduğunuzdan emin olun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接 TCP。请确保已启用回环 VPN，并处于 Wi-Fi 或飞行模式。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر الاتصال عبر TCP. تأكد من تفعيل VPN الحلقي وأنك على Wi-Fi أو في وضع الطيران."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể kết nối TCP. Hãy bật VPN loopback và dùng Wi-Fi hoặc Chế độ máy bay."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile connettersi via TCP. Assicurati che la VPN di loopback sia attiva e di essere in Wi-Fi o in modalità aereo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine TCP-Verbindung möglich. Stelle sicher, dass das Loopback-VPN aktiv ist und du im WLAN oder im Flugmodus bist."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat terhubung ke TCP. Pastikan VPN loopback aktif dan kamu menggunakan Wi-Fi atau Mode Pesawat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelze se připojit přes TCP. Zkontrolujte, že je zapnutá loopback VPN a jste na Wi-Fi nebo v režimu Letadlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connexion TCP impossible. Vérifiez que le VPN loopback est activé et que vous êtes en Wi-Fi ou en mode Avion."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удаётся подключиться по TCP. Убедитесь, что loopback-VPN включён и вы в сети Wi-Fi или в авиарежиме."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede conectar por TCP. Asegúrate de tener activada la VPN loopback y de estar en Wi-Fi o en modo avión."
          }
        }
      }
    },
