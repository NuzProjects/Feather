    "By default, localized titles for the app won't be changed, however this option overrides it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بشكل افتراضي، لن يتم تغيير العناوين المترجمة للتطبيق، لكن هذا الخيار يتجاوز ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig werden lokalisierte Titel der App nicht geändert, diese Option überschreibt dies jedoch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By default, localized titles for the app won't be changed, however this option overrides it."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di default, i titoli tradotti delle app non cambieranno, ma questa opzione lo sostituisce."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본적으로 앱의 현지화된 제목은 변경되지 않지만, 이 옵션을 선택하면 기본 설정이 무시됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domyślnie tłumaczone tytuły aplikacji nie będą zmieniane, jednak ta opcja to nadpisuje."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsayılan olarak, uygulamanın yerelleştirilmiş başlıkları değiştirilmeyecektir, ancak bu seçenek bunu geçersiz kılar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theo mặc định, tiêu đề bản địa hóa cho ứng dụng sẽ không bị thay đổi, tuy nhiên tùy chọn này sẽ ghi đè lên nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在默认情况下，应用的本地化标题保持不变。此选项将取消这一限制。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secara bawaan judul aplikasi yang dilokalkan tidak diubah, namun opsi ini menimpanya."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve výchozím stavu se lokalizované názvy aplikace nemění, tato volba je ale přepíše."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par défaut, les titres localisés de l’app ne changent pas, mais cette option les remplace."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По умолчанию локализованные названия приложения не меняются, но этот параметр их заменяет."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De forma predeterminada no se cambian los nombres localizados de la app, pero esta opción los reemplaza."
          }
        }
      }
    },
