    "You cannot update ‘%@‘ with itself, please use an alternative tool to update it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكنك تحديث ‘%@‘ بنفسه، يرجى استخدام أداة بديلة لتحديثه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst ‘%@‘ nicht mit sich selbst aktualisieren. Bitte verwende dafür ein alternatives Tool."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You cannot update ‘%@‘ with itself, please use an alternative tool to update it."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu tidak bisa melakukan update pada ‘%@’ menggunakan dirinya sendiri. Silakan gunakan tool alternatif untuk memperbaruinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non puoi aggiornare ‘%@‘ con se stesso, usa un altro tool per fare l’aggiornamento."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`%@`을(를) 자체적으로 업데이트할 수 없습니다. 다른 도구를 사용해 업데이트해 주세요.\n"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można zaktualizować „%@” przy jego użyciu. Użyj innego narzędzia do aktualizacji."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@’ı kendisi üzerinden güncelleyemezsiniz. Lütfen güncelleme için alternatif bir araç kullanın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn không thể cập nhật ‘%@‘ bằng chính nó, vui lòng sử dụng công cụ thay thế để cập nhật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不能用‘%@’更新自己，请使用其他工具更新。"
          }
        }
      }
    },
    "Your pairing file is invalid and is incompatible with your device, please import a valid pairing file." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملف pairing غير صالح وغير متوافق مع جهازك، يرجى استيراد ملف pairing صالح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Pairing-Datei ist ungültig und nicht mit deinem Gerät kompatibel. Bitte importiere eine gültige Pairing-Datei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your pairing file is invalid and is incompatible with your device, please import a valid pairing file."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo file di abbinamento non è valido e non è compatibile con il tuo dispositivo, per favore importa un file di abbinamento valido."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "페어링 파일이 올바르지 않거나 기기와 호환되지 않습니다. 유효한 페어링 파일을 가져와 주세요.\n"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój plik parowania jest nieprawidłowy i niekompatybilny z urządzeniem. Zaimportuj poprawny plik."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eşleştirme dosyanız geçersiz ve cihazınızla uyumlu değil. Lütfen geçerli bir eşleştirme dosyası içe aktarın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tệp ghép nối của bạn không hợp lệ và không tương thích với thiết bị của bạn, vui lòng nhập tệp ghép nối hợp lệ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配对文件不可用并且与设备不匹配，请导入可用的的配置文件。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File pairing kamu tidak valid dan tidak cocok dengan perangkatmu. Impor file pairing yang valid."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soubor párování je neplatný a není kompatibilní s vaším zařízením. Importujte platný soubor párování."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre fichier de jumelage n’est pas valide et n’est pas compatible avec votre appareil. Importez un fichier de jumelage valide."
          }
        },
        "ru" : {
          "stringUnit" : {
