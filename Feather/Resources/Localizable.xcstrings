    "Apps signed with this certificate only open on devices listed in its provisioning profile." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps signed with this certificate only open on devices listed in its provisioning profile."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التطبيقات الموقّعة بهذه الشهادة تعمل فقط على الأجهزة المدرجة في ملف التزويد الخاص بها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace podepsané tímto certifikátem se otevřou jen na zařízeních uvedených v jeho zřizovacím profilu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit diesem Zertifikat signierte Apps öffnen sich nur auf Geräten, die in seinem Bereitstellungsprofil stehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps firmadas con este certificado solo se abren en los dispositivos incluidos en su perfil de aprovisionamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps signées avec ce certificat ne s’ouvrent que sur les appareils listés dans son profil d’approvisionnement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi yang ditandatangani dengan sertifikat ini hanya terbuka di perangkat yang tercantum di profil provisioning-nya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le app firmate con questo certificato si aprono solo sui dispositivi elencati nel suo profilo di provisioning."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 인증서로 서명한 앱은 프로비저닝 프로필에 등록된 기기에서만 열립니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacje podpisane tym certyfikatem otwierają się tylko na urządzeniach z jego profilu aprowizacji."
